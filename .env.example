# PostgreSQL (Railway em produção; local: `npm run db:local` sobe um Postgres embutido)
DATABASE_URL=

# Admin (obrigatórios em produção). Use uma senha forte e um segredo longo e aleatório
# (ex.: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Pix estático (BR Code). NUNCA invente uma chave: deixe vazio até ter a chave real.
PIX_KEY=
# Nome do recebedor (máx. 25 caracteres, sem acentos é o ideal)
PIX_RECEIVER_NAME=
# Cidade do recebedor (máx. 15 caracteres)
PIX_RECEIVER_CITY=
# Prefixo opcional da descrição exibida no app do banco (ex.: "Presente Jose")
PIX_DESCRIPTION_PREFIX=

# URL pública da aplicação (ex.: https://jose2anos.vercel.app)
NEXT_PUBLIC_APP_URL=
